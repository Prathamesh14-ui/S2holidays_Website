# ---------------------------------------------------------------------------
# S2 Holidays – environment variables. Copy to .env.local and fill in.
# Never commit .env.local. Variables prefixed NEXT_PUBLIC_ are sent to browsers;
# everything else stays on the server.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS (https://www.sanity.io/manage). Leave the project ID empty to run with
# the bundled, clearly labelled SAMPLE content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01

# Server-only token with "Editor" permissions – used ONLY to save enquiries (leads).
SANITY_API_WRITE_TOKEN=
# Optional server-only read token (required if the dataset is PRIVATE – recommended).
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook that refreshes the site after publishing.
SANITY_REVALIDATE_SECRET=

# WhatsApp click-to-chat number in international format, digits only (e.g. 9198XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Email notifications via Resend (https://resend.com). FROM must be on a verified domain.
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=
ENQUIRY_FROM_EMAIL=

# Set to "true" to hide the "sample content" banner once all content is verified.
NEXT_PUBLIC_HIDE_SAMPLE_BANNER=
